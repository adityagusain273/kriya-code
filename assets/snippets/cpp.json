{
  "main": {
    "prefix": "main",
    "body": [
      "int main() {",
      "\t${0}",
      "\treturn 0;",
      "}"
    ],
    "description": "Main function"
  },
  "inc": {
    "prefix": "inc",
    "body": "#include <${1:iostream}>",
    "description": "Include iostream"
  },
  "cin": {
    "prefix": "cin",
    "body": "std::cin >> ${1:var};",
    "description": "Input from cin"
  },
  "cout": {
    "prefix": "cout",
    "body": "std::cout << \"${1:text}\" << std::endl;",
    "description": "Output to cout"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "\t${0}",
      "}"
    ],
    "description": "For loop"
  },
  "forr": {
    "prefix": "forr",
    "body": [
      "for (const auto& ${1:item} : ${2:container}) {",
      "\t${0}",
      "}"
    ],
    "description": "Range-based for loop"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "If statement"
  },
  "ife": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "\t${0}",
      "} else {",
      "\t",
      "}"
    ],
    "description": "If-else statement"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "public:",
      "\t${1:Name}() {}",
      "};"
    ],
    "description": "Class definition"
  },
  "vec": {
    "prefix": "vec",
    "body": "std::vector<${1:int}> ${2:name};",
    "description": "Vector declaration"
  },
  "map": {
    "prefix": "map",
    "body": "std::map<${1:key}, ${2:value}> ${3:name};",
    "description": "Map declaration"
  },
  "func": {
    "prefix": "func",
    "body": [
      "${1:void} ${2:name}(${3}) {",
      "\t${0}",
      "}"
    ],
    "description": "Function definition"
  },
  "lambda": {
    "prefix": "lambda",
    "body": "[${1:capture}](${2:params}) { ${0} }",
    "description": "Lambda expression"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:val}:",
      "\t\t${0}",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ],
    "description": "Switch statement"
  }
}