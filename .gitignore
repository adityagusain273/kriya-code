# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing — never commit
key.properties
android/key.properties
*.jks
*.keystore
*.p12
*.pfx
*.pem

# Dart symbol files produced by --split-debug-info belong in the crash
# backend, not in the repository.
/symbols/

# Local scratch: patch/patch-application leftovers
*.orig
*.rej
*.patch

# Local scratch: one-off scripts and throwaway probes kept out of lib/
/scratch.dart
/test_bracket*.dart
/test_regex.dart
/test_script.dart
/*.py
/*.sh

# Firebase — not wired up; do not commit a config that implies it is
android/app/google-services.json

# Runtime payloads produced by tool/bundle_runtime.py.
#
# These are large, machine-specific build inputs (a few hundred MB across ABIs),
# not source. The app does not need them: runtimes are installed on demand the way
# VS Code installs an extension, which also means a new language version reaches the
# user without an app release. Run the script only when building an offline-first
# or store-policy flavour that must carry a runtime inside the package.
android/app/src/main/assets/bundled_runtime/
.agent/

# Offline mirror of the Flutter engine artifacts, rebuilt by
# tool/make-local-engine-repo.sh from the jars inside the Flutter SDK.
#
# Roughly 1 GB of machine-specific binaries. Only needed where
# storage.googleapis.com is unreachable; android/build.gradle.kts skips it when the
# directory is absent, so it is never committed.
android/local-engine-repo/

# Harness-memory local database
.harness-memory/

# OpenCode tooling
.opencode/
opencode.json

# Knowledge graph
graphify-out/


# Android build outputs (leaked absolute paths when committed)
android/build/
