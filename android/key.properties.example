# Copy this file to android/key.properties and fill in real values.
# NEVER commit the real key.properties or your .jks keystore.
#
# Generate a keystore:
#   keytool -genkey -v -keystore ~/bcode-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias bcode
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=bcode
storeFile=/absolute/path/to/bcode-release.jks
